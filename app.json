{
  "expo": {
    "name": "Weepo",
    "slug": "companion-b2c",
    "version": "0.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monmon.companion",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Weepo will use the microphone for voice input when speech-to-text is enabled in a future update.",
        "NSSpeechRecognitionUsageDescription": "Weepo will use speech recognition for hands-free chat when enabled in a future update.",
        "NSCameraUsageDescription": "Camera is not used in this version."
      }
    },
    "android": {
      "package": "com.monmon.companion",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
